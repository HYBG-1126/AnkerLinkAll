{
  "name": "ankerlinkall",
  "private": true,
  "version": "0.1.0",
  "description": "安克万连：基于蓝牙发现并控制附近安克设备的 macOS 菜单栏应用",
  "type": "module",
  "main": "electron/main.mjs",
  "author": "HYBG",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k -n vite,electron \"vite --port 5173 --strictPort\" \"wait-on http://localhost:5173 && DESKTOP_SHOW=1 electron .\"",
    "desktop:pack": "npm run build && electron-builder --mac --arm64 --dir",
    "desktop:build": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.hybg.ankerlinkall",
    "productName": "AnkerLinkAll",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.mjs",
      "electron/preload.cjs",
      "electron/picker.html",
      "electron/picker-preload.cjs",
      "electron/assets/trayTemplate.png",
      "electron/assets/trayTemplate@2x.png",
      "package.json",
      "!**/*.baiduyun.*",
      "!**/.DS_Store"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "electron/assets/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSBluetoothAlwaysUsageDescription": "AnkerLinkAll 需要蓝牙权限，用于发现并连接附近的安克设备。",
        "NSBluetoothPeripheralUsageDescription": "AnkerLinkAll 需要蓝牙权限，用于发现并连接附近的安克设备。"
      }
    }
  }
}
